KAIRO_ENV=dev

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kairo_chunks
QDRANT_DISTANCE=Cosine
CLOUD_RECREATE_COLLECTION=false

KEYWORD_SEARCH_PROVIDER=bm25
CLOUD_INDEX_MANIFEST_PATH=data/cloud_index_manifest.json
CLOUD_BM25_INDEX_PATH=data/cloud_bm25_index.json
CLOUD_CHUNK_BATCH_SIZE=64

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
BING_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RESULTS=5
JOB_FRESHNESS_ENABLED=true
JOB_VERIFICATION_MAX_RESULTS=5
JOB_VERIFICATION_REQUEST_TIMEOUT_SECONDS=20

RERANKER_PROVIDER=base_score
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-2
OPENAI_RERANK_MODEL=gpt-4.1-mini
CROSS_ENCODER_MODEL=
RERANK_TOP_K=5
RERANK_CANDIDATE_COUNT=20
RERANK_TIMEOUT_SECONDS=30

QDRANT_METADATA_WRITE_ENABLED=false
QDRANT_METADATA_WRITE_DRY_RUN=true
QDRANT_METADATA_ALLOWED_FIELDS=verification_status,archived,archived_at,closed_reason,canonical_url,original_url,last_verified_at,verification_confidence,manual_review_required,duplicate_of
FRESHNESS_AUDIT_LOG_PATH=data/freshness_audit.jsonl
TRACE_LOG_PATH=data/trace_events.jsonl
OBSERVABILITY_ENABLED=true

MAX_SEARCH_RESULTS=10
MAX_CHUNKS_TO_READ=5
MAX_CONTEXT_TOKENS=6000
MAX_TOOL_CALLS=20
REQUEST_TIMEOUT_SECONDS=30
